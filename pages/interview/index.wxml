<t-toast id="t-toast" />

<view class="iv-page">
  <image class="iv-page__nav-bg" src="/static/bg_navbar.png" mode="aspectFill" />
  <nav title-text="AI 面试陪练" />

  <view class="iv-page__body">
    <view class="iv-status {{statusClass}}">
      <view class="iv-status__dot" />
      <text class="iv-status__text">{{statusText}}</text>
      <text wx:if="{{sessionId}}" class="iv-status__sid">{{sessionIdShort}}</text>
    </view>

    <scroll-view
      wx:if="{{!messages.length}}"
      class="iv-welcome"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
    >
      <view class="iv-brand">
        <view class="iv-brand__badge">
          <t-icon name="user-talk" size="48rpx" color="#fff" />
        </view>
        <text class="iv-brand__title">模拟技术面试</text>
        <text class="iv-brand__desc">Agent 会结合题库追问，并在回答后给出评分建议</text>
      </view>

      <view class="iv-welcome__section">
        <text class="iv-welcome__label">快速开始</text>
        <view class="iv-suggestions">
          <view
            wx:for="{{suggestions}}"
            wx:key="id"
            class="iv-suggestion"
            hover-class="iv-suggestion--active"
            data-text="{{item.text}}"
            bindtap="onSuggestionTap"
          >
            <t-icon name="{{item.icon}}" size="32rpx" />
            <text>{{item.text}}</text>
          </view>
        </view>
      </view>

      <view class="iv-welcome__tips">
        <t-icon name="info-circle" size="28rpx" />
        <text>连接使用 Header 鉴权；同一会话同时只允许一路生成；面试记录会自动保存</text>
      </view>
    </scroll-view>

    <scroll-view
      wx:else
      class="iv-messages"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
      scroll-into-view="{{anchor}}"
    >
      <view
        wx:for="{{messages}}"
        wx:key="id"
        id="msg-{{item.id}}"
        class="iv-msg iv-msg--{{item.role}}"
      >
        <view class="iv-msg__bubble">
          <text class="iv-msg__role">{{item.role === 'user' ? '我' : '面试官'}}</text>
          <text class="iv-msg__content" user-select>{{item.content || (item.streaming ? '思考中…' : '')}}</text>
          <t-loading wx:if="{{item.streaming}}" theme="circular" size="28rpx" />
        </view>
      </view>
      <view id="iv-bottom" style="height: 24rpx;" />
    </scroll-view>
  </view>

  <view class="iv-composer">
    <view class="iv-composer__actions">
      <view
        class="iv-chip {{connected ? '' : 'iv-chip--primary'}}"
        hover-class="iv-chip--active"
        bindtap="onToggleConnect"
      >
        <text>{{connected ? '断开' : '连接'}}</text>
      </view>
      <view
        class="iv-chip"
        hover-class="iv-chip--active"
        bindtap="onOpenHistory"
      >
        <text>历史</text>
      </view>
      <view
        class="iv-chip"
        hover-class="iv-chip--active"
        bindtap="onNewSession"
      >
        <text>新面试</text>
      </view>
    </view>
    <view class="iv-composer__row">
      <textarea
        class="iv-input"
        value="{{input}}"
        maxlength="4000"
        placeholder="{{connected ? '输入你的回答或开场介绍…' : '请先连接面试官'}}"
        disabled="{{sending || !connected}}"
        bindinput="handleInput"
        auto-height
        show-confirm-bar="{{false}}"
      />
      <view
        class="iv-send {{input && connected && !sending ? 'iv-send--ready' : ''}}"
        hover-class="iv-send--active"
        bindtap="handleSubmit"
      >
        <t-loading wx:if="{{sending}}" theme="circular" size="32rpx" />
        <t-icon wx:else name="send" size="36rpx" color="#fff" />
      </view>
    </view>
  </view>

  <view wx:if="{{showHistory}}" class="iv-history-mask" bindtap="onCloseHistory">
    <view class="iv-history" catchtap="">
      <view class="iv-history__hd">
        <text class="iv-history__title">面试历史</text>
        <view class="iv-history__close" bindtap="onCloseHistory">
          <t-icon name="close" size="36rpx" />
        </view>
      </view>
      <view wx:if="{{historyLoading}}" class="iv-history__loading">
        <t-loading theme="circular" size="40rpx" />
        <text>加载中…</text>
      </view>
      <scroll-view wx:else class="iv-history__list" scroll-y enhanced show-scrollbar="{{false}}">
        <view wx:if="{{!historyList.length}}" class="iv-history__empty">
          <text>暂无面试记录</text>
        </view>
        <view
          wx:for="{{historyList}}"
          wx:key="sessionId"
          class="iv-history__item {{item.active ? 'iv-history__item--active' : ''}}"
        >
          <view
            class="iv-history__main"
            data-session-id="{{item.sessionId}}"
            bindtap="onSelectHistory"
          >
            <text class="iv-history__name">{{item.title}}</text>
            <text class="iv-history__preview">{{item.preview || '暂无消息'}}</text>
            <text class="iv-history__meta">消息 {{item.messageCount}}</text>
          </view>
          <view
            class="iv-history__del"
            data-session-id="{{item.sessionId}}"
            catchtap="onDeleteHistory"
          >
            <t-icon name="delete" size="32rpx" />
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
