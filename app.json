{
  "lazyCodeLoading": "requiredComponents",
  "pages": [
    "pages/category/index",
    "pages/interviewMemo/index",
    "pages/mknow/index",
    "pages/my/index",
    "pages/agreement/agreement",
    "pages/interviewMemo/edit/index"
  ],
  "usingComponents": {
    "nav": "/components/nav",
    "t-cascader": "/miniprogram_npm/tdesign-miniprogram/cascader/cascader",
    "t-search": "/miniprogram_npm/tdesign-miniprogram/search/search"
  },
  "subpackages": [
    {
      "root": "subpackages/mobileAdmin",
      "name": "mobileAdmin",
      "pages": ["index"]
    },
    {
      "root": "pages/question",
      "name": "question",
      "pages": ["index", "detail/index"]
    },
    {
      "root": "pages/document",
      "name": "document",
      "pages": ["index", "preview/index", "edit/index"]
    },
    {
      "root": "pages/creator",
      "name": "creator",
      "pages": ["index"]
    },
    {
      "root": "pages/search",
      "name": "search",
      "pages": ["index", "result/index"]
    },
    {
      "root": "pages/my/info-edit",
      "name": "edit",
      "pages": ["index"]
    },
    {
      "root": "pages/my/profession",
      "name": "profession",
      "pages": ["index"]
    },
    {
      "root": "pages/login",
      "name": "login",
      "pages": ["login"]
    },
    {
      "root": "pages/dataCenter",
      "name": "dataCenter",
      "pages": ["index"]
    },
    {
      "root": "pages/setting",
      "name": "setting",
      "pages": ["index"]
    },
    {
      "root": "pages/ucenter",
      "name": "ucenter",
      "pages": [
        "favorite/index",
        "ranking/index",
        "points/index",
        "points/redeem/index",
        "points/appeals/index",
        "points/invite/index",
        "history/index",
        "following/index",
        "followers/index",
        "visits/index",
        "notifications/index",
        "blacklist/index",
        "profile/index",
        "business/index"
      ]
    },
    {
      "root": "pages/interview",
      "name": "interview",
      "pages": ["index"]
    },
    {
      "root": "pages/publish",
      "name": "publish",
      "pages": ["index"]
    },
    {
      "root": "subpackages/towxml",
      "name": "towxml",
      "pages": ["index"]
    }
  ],
  "preloadRule": {
    "pages/my/index": {
      "network": "all",
      "packages": ["mobileAdmin"]
    },
    "pages/category/index": {
      "network": "all",
      "packages": ["question"]
    },
    "pages/mknow/index": {
      "network": "all",
      "packages": ["towxml"]
    },
    "pages/question/index": {
      "network": "all",
      "packages": ["towxml"]
    },
    "pages/search/index": {
      "network": "all",
      "packages": ["question"]
    },
    "pages/search/result/index": {
      "network": "all",
      "packages": ["question"]
    }
  },
  "window": {
    "enablePullDownRefresh": true,
    "backgroundTextStyle": "light",
    "navigationBarBackgroundColor": "#fff",
    "navigationBarTitleText": "Weixin",
    "navigationBarTextStyle": "black",
    "enableShareTimeline": true
  },
  "tabBar": {
    "custom": true,
    "list": [
      {
        "pagePath": "pages/category/index",
        "text": "题库"
      },
      {
        "pagePath": "pages/interviewMemo/index",
        "text": "速记"
      },
      {
        "pagePath": "pages/mknow/index",
        "text": "m知道"
      },
      {
        "pagePath": "pages/my/index",
        "text": "我的"
      }
    ]
  },
  "resolveAlias": {
    "~/*": "/*"
  },
  "sitemapLocation": "sitemap.json"
}
